{
  "manifest_version": 2,
  "version": "2.4.8",
  "name": "AI Draw 图片生成插件",
  "description": "AI 绘图插件。命令前缀 /ad。支持有界任务队列、状态与取消、连续绘图、多模型热切换、LLM 提示词生成、风格/提示词预设、自拍、图生图/参考模式、双发送模式与精确撤回。",
  "author": {
    "name": "AI Draw Contributors",
    "url": "https://github.com/yueshenqiu/ai_draw_plugin"
  },
  "license": "GPL-3.0-or-later",
  "urls": {
    "repository": "https://github.com/yueshenqiu/ai_draw_plugin",
    "homepage": "https://github.com/yueshenqiu/ai_draw_plugin"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.4.0"
  },
  "sdk": {
    "min_version": "2.5.0",
    "max_version": "2.99.0"
  },
  "dependencies": [],
  "capabilities": [
    "send.text",
    "message.get_recent",
    "message.get_by_id",
    "llm.generate",
    "api.call"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": ["zh-CN"]
  },
  "id": "github.yueshenqiu.ai-draw-plugin"
}
